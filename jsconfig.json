{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    },
    "jsx": "react-jsx",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["esnext", "dom"],
    "target": "esnext",
    "checkJs": true,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "resolveJsonModule": true
  },
  "include": [
    "src/**/*",           // src配下すべてを対象にする（これが一番確実！）
    "src/**/*.js",
    "src/**/*.jsx"
, "vite-env.d.ts"  ],
  "exclude": [
    "node_modules",
    "dist",
    "src/components/ui"  // 自動生成されたUIコンポーネントのみ除外
  ]
}