{
  "extends": ["stylelint-config-standard"],
  "rules": {
    "at-rule-no-unknown": [
      true,
      {
        "ignoreAtRules": [
          "tailwind",
          "apply",
          "layer",
          "responsive",
          "component",
          "variants"
        ]
      }
    ],
    "declaration-block-no-duplicate-properties": true
  }
}
